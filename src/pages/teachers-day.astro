			const update = () => setProgress((imgDone / 2) * 0.35 + audioProg * 0.65);
			const jobs = [
				loadImage(zjUrl).then(() => { imgDone++; update(); }),
				loadImage(zfUrl).then(() => { imgDone++; update(); }),
				loadAudio(bgmUrl, (p) => { audioProg = p; update(); }),
