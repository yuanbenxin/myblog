			dQuote.innerHTML = "";
			[...t.quote].forEach((ch) => {
				const s = document.createElement("span");
				s.className = "td-qch"; s.textContent = ch === " " ? " " : ch;
				dQuote.appendChild(s);
			});
			dFacts.innerHTML = "";
			t.facts.forEach((f) => {
				const li = document.createElement("li"); li.textContent = f; dFacts.appendChild(li);
			});

			// 卡片飞入详情位
			const home = cardHomes ? cardHomes[i] : cardEls[i].getBoundingClientRect();
			detail.classList.add("td-show");
			detail.style.opacity = "0";
			const target = dPhoto.getBoundingClientRect();
			detail.style.opacity = "";
			const fly = document.createElement("div");
			fly.style.cssText = `position:fixed;z-index:70;left:${home.left}px;top:${home.top}px;width:${home.width}px;height:${home.height}px;border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(192,133,82,.45);`;
			fly.innerHTML = t.photo
				? `<img src="${t.photo}" style="width:100%;height:100%;object-fit:cover">`
				: `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#fff,#ffe9d2);padding:8px;text-align:center;font-weight:700;color:#5b3a29;font-size:14px">${t.card}</div>`;
			stage.appendChild(fly);
			const anim = fly.animate(
				[
					{ left: home.left + "px", top: home.top + "px", width: home.width + "px", height: home.height + "px", transform: "rotate(0deg)" },
					{ left: target.left + "px", top: target.top + "px", width: target.width + "px", height: target.height + "px", transform: "rotate(3deg)" },
				],
				{ duration: dur * 0.24, easing: "cubic-bezier(.45,1.4,.45,1)", fill: "forwards" }
			);
			await anim.finished.catch(() => {});
			fly.remove();

			// 详情内容入场
			const qchs = dQuote.querySelectorAll(".td-qch");
			const inAnims = [];
			inAnims.push(dPhoto.animate(
				[{ opacity: 0, transform: "scale(.92)" }, { opacity: 1, transform: "scale(1)" }],
				{ duration: dur * 0.14, easing: "ease-out", fill: "forwards" }));
			inAnims.push(dName.animate(
				[{ opacity: 0, transform: "translateX(60px) scale(.8)" }, { opacity: 1, transform: "translateX(0) scale(1.06)", offset: .7 }, { opacity: 1, transform: "translateX(0) scale(1)" }],
				{ duration: dur * 0.16, delay: dur * 0.05, easing: "cubic-bezier(.3,1.5,.5,1)", fill: "forwards" }));
			qchs.forEach((s, j) => inAnims.push(s.animate(
				[{ opacity: 0, transform: "translateY(20px) scale(.4)" }, { opacity: 1, transform: "translateY(0) scale(1)" }],
				{ duration: dur * 0.1, delay: dur * 0.12 + j * 28, easing: "cubic-bezier(.3,1.8,.5,1)", fill: "forwards" })));
			const lis = dFacts.querySelectorAll("li");
			lis.forEach((li, j) => inAnims.push(li.animate(
				[{ opacity: 0, transform: "translateX(-50px) scale(.7)" }, { opacity: 1, transform: "translateX(0) scale(1)" }],
				{ duration: dur * 0.12, delay: dur * 0.2 + j * dur * 0.055, easing: "cubic-bezier(.3,1.7,.5,1)", fill: "forwards" })));
			await Promise.all(inAnims.map((a) => a.finished.catch(() => {})));

			// 弹簧律动（跟随 BGM 低频能量）
			springLines = [dName, dQuote, ...lis].map((el, j) => makeSpring(el, j));
			if (!springOn) { springOn = true; tickSprings(); }

			// 停留
			await new Promise((r) => after(dur * 0.5, r));

			// 退出
			springLines = [];
			await Promise.all([
				detail.animate([{ opacity: 1 }, { opacity: 0 }], { duration: dur * 0.12, fill: "forwards" }).finished.catch(() => {}),
				...[dName, dQuote, ...lis].map((el, j) => el.animate(
					[{ opacity: 1, transform: "translateY(0)" }, { opacity: 0, transform: "translateY(30px)" }],
					{ duration: dur * 0.1, delay: j * 30, fill: "forwards" }).finished.catch(() => {})),
			]);
			detail.classList.remove("td-show");
			detail.classList.add("td-hide");
			[dName, dQuote, ...lis].forEach((el) => { el.style.transform = ""; el.style.opacity = ""; });
			detail.getAnimations().forEach((a) => a.cancel());
			detail.classList.remove("td-hide");
			await new Promise((r) => after(dur * 0.04, r));
		}

		/* ---------- 结尾烟花 ---------- */
		const fwC = $("td-fireworks"), fctx = fwC.getContext("2d");
		let fwOn = false, fwParts = [], fwRockets = [], fwLast = 0;
		const FW_COLORS = ["#FF8C42", "#FF6F61", "#FFD166", "#C08552", "#FFE8CC"];
		function launchRocket() {
			fwRockets.push({
				x: fwC.width * (0.15 + Math.random() * 0.7), y: fwC.height + 10,
				vy: -(fwC.height * (0.011 + Math.random() * 0.004)),
				color: FW_COLORS[Math.floor(Math.random() * FW_COLORS.length)],
			});
		}
		function explode(x, y, color) {
			const N = MOBILE ? 40 : 70;
			for (let i = 0; i < N; i++) {
				const a = (i / N) * Math.PI * 2 + Math.random() * .3;
				const sp = (1.5 + Math.random() * 3.5) * devicePixelRatio;
				fwParts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, life: 1, decay: .008 + Math.random() * .012, color });
			}
		}
		function tickFireworks(now) {
			if (!fwOn) return;
			fctx.clearRect(0, 0, fwC.width, fwC.height);
			if (now - fwLast > (MOBILE ? 900 : 550)) { fwLast = now; launchRocket(); if (Math.random() < .4) launchRocket(); }
			fwRockets = fwRockets.filter((r) => {
				r.y += r.vy;
				fctx.globalAlpha = 1; fctx.fillStyle = r.color;
				fctx.beginPath(); fctx.arc(r.x, r.y, 2.5 * devicePixelRatio, 0, Math.PI * 2); fctx.fill();
				if (r.y < fwC.height * (0.2 + Math.random() * 0.25)) { explode(r.x, r.y, r.color); return false; }
				return true;
			});
			fwParts = fwParts.filter((p) => {
				p.x += p.vx; p.y += p.vy; p.vy += 0.03 * devicePixelRatio; p.vx *= .99; p.life -= p.decay;
				if (p.life <= 0) return false;
				fctx.globalAlpha = p.life; fctx.fillStyle = p.color;
				fctx.beginPath(); fctx.arc(p.x, p.y, 2 * devicePixelRatio * p.life + .5, 0, Math.PI * 2); fctx.fill();
				return true;
			});
			fctx.globalAlpha = 1;
			rafs.push(requestAnimationFrame(tickFireworks));
		}

		/* ---------- 主时间轴（缩放到 BGM 时长 - 10s 结尾） ---------- */
		let t0 = 0, masterOn = false, schedule = [];
		const ENDING_HOLD = 10; // 结尾页占用音频最后 10 秒
		function buildSchedule() {
			const D = isFinite(audio.duration) && audio.duration > 20 ? audio.duration : 61.008;
			const main = D - ENDING_HOLD;
			const W = [
				["intro", 1.0], ["cover", 4.5], ["open", 4.5], ["memory", 4.0],
				["growth", 4.0], ["thanks", 3.5], ["cards", 7.5],
				...TEACHERS.map((_, i) => ["teacher" + i, 4.0]),
			];
			const sum = W.reduce((s, w) => s + w[1], 0);
			const scale = main / sum;
			let acc = 0;
			schedule = W.map(([key, w]) => {
				const start = acc; acc += w * scale;
				return { key, start, dur: w * scale };
			});
		}
		const fired = new Set();
		function at(key) { return schedule.find((s) => s.key === key); }

		function runPhase(key, dur) {
			switch (key) {
				case "intro": {
					// 导航栏向上滑出
					const nav = document.getElementById("navbar-wrapper");
					if (nav) {
						nav.style.transition = "transform .9s cubic-bezier(.6,0,.8,.4), opacity .9s";
						nav.style.transform = "translateY(-130%)";
						nav.style.opacity = "0";
					}
					showPage(null, 0);
					break;
				}
				case "cover": showPage("cover", 0); break;
				case "open": showPage("open", 1); break;
				case "memory": showPage("memory", 2); break;
				case "growth": showPage("growth", 3); break;
				case "thanks": showPage("thanks", 4); break;
				case "cards": {
					showPage("cards", 5);
					cardsIn(dur * 1000);
					const ms = dur * 1000;
					after(ms * 0.34, () => captureHomes());
					after(ms * 0.36, () => cardsGather(ms * 0.1));
					after(ms * 0.48, () => cardsShuffle(2, ms * 0.3));
					after(ms * 0.8, () => cardsDeal(ms * 0.2));
					break;
				}
				case "ending": {
					showPage("ending", 6);
					sizeCanvas(fwC);
					if (!fwOn) { fwOn = true; fwLast = 0; rafs.push(requestAnimationFrame(tickFireworks)); }
					unlockAll(); // 动效结束，解锁交互
					break;
				}
				default: {
					if (key.startsWith("teacher")) {
						showPage("cards", 5);
						$("td-cards-cap").classList.remove("td-show");
						showTeacher(+key.slice(7), dur * 1000);
					}
				}
			}
		}

		function tickMaster() {
			if (!masterOn) return;
			const t = (performance.now() - t0) / 1000;
			for (const ph of schedule) {
				if (t >= ph.start && !fired.has(ph.key)) {
					fired.add(ph.key);
					runPhase(ph.key, ph.dur);
				}
			}
			rafs.push(requestAnimationFrame(tickMaster));
		}

		function startShow() {
			buildSchedule();
			fired.clear();
			// 重置状态
			detail.classList.remove("td-show");
			springLines = [];
			fwOn = false; fwParts = []; fwRockets = [];
			fctx && fctx.clearRect(0, 0, fwC.width, fwC.height);
			cardEls.forEach((c, i) => { c.getAnimations().forEach((a) => a.cancel()); c.style.transform = ""; c.style.transition = ""; c.classList.remove("td-dim"); c.style.opacity = 0; cardState[i].x = 0; cardState[i].y = 0; cardState[i].rot = 0; });
			$("td-cards-cap").classList.remove("td-show");
			if (currentPage) { pages[currentPage].classList.remove("td-active"); currentPage = null; }
			lockAll();

			audio.currentTime = 0;
			audio.play().catch(() => {});
			t0 = performance.now();
			masterOn = true;
			tickMaster();
		}

		/* ---------- 开始按钮：解锁音频自动播放 ---------- */
		listen(btnStart, "click", () => {
			if (!audioReady) return;
			// Web Audio 用于弹簧律动取低频能量
			try {
				if (!actx) {
					actx = new (window.AudioContext || window.webkitAudioContext)();
					const src = actx.createMediaElementSource(audio);
					analyser = actx.createAnalyser();
					analyser.fftSize = 128;
					src.connect(analyser); analyser.connect(actx.destination);
					freq = new Uint8Array(analyser.frequencyBinCount);
				}
				actx.resume();
			} catch (e) { /* 律动退化为纯呼吸 */ }
			loader.classList.add("td-gone");
			stage.classList.add("td-on");
			stage.setAttribute("aria-hidden", "false");
			startShow();
		});

		/* ---------- 重播 ---------- */
		listen($("td-replay"), "click", () => {
			startShow(); // 资源已缓存，直接重播主内容，音乐从头播放
		});

		/* ---------- 静音 ---------- */
		listen($("td-mute"), "click", () => {
			audio.muted = !audio.muted;
			$("td-icon-sound").style.display = audio.muted ? "none" : "";
			$("td-icon-mute").style.display = audio.muted ? "" : "none";
		});

		/* ---------- 销毁（swup 换页） ---------- */
		window.__td = {
			destroy() {
				masterOn = false; springOn = false; petalsOn = false; fwOn = false;
				timers.forEach(clearTimeout); timers = [];
				rafs.forEach(cancelAnimationFrame); rafs = [];
				listeners.forEach(([el, ev, fn, opt]) => el.removeEventListener(ev, fn, opt)); listeners = [];
				try { audio.pause(); audio.src = ""; } catch (e) {}
				document.body.style.overflow = "";
			},
		};
		if (window.swup && window.swup.hooks) {
			window.swup.hooks.on("content:replace", () => {
				if (window.__td) { window.__td.destroy(); window.__td = null; }
			});
		}
	})();
	</script>
</BlankLayout>
