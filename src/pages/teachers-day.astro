---
import BlankLayout from "../layouts/BlankLayout.astro";
import zjUrl from "../assets/images/zj.jpg";
import zfUrl from "../assets/images/zf.png";
import bgmUrl from "../assets/bgm.mp3";
---

<BlankLayout title="教师节快乐" description="高三23班 · 教师节特别企划">
	<link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
	<link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		slot="head"
		href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+KuaiLe&display=swap"
		rel="stylesheet"
	/>

	<div id="td-root">
		<!-- ===== 加载页 ===== -->
		<div id="td-loader">
			<div class="td-loader-inner">
				<svg class="td-loader-flower" viewBox="0 0 100 100" width="72" height="72" aria-hidden="true">
					<g class="td-flower-spin">
						<circle cx="50" cy="30" r="13" fill="#FF8C42" opacity=".9" />
						<circle cx="68" cy="44" r="13" fill="#FF6F61" opacity=".9" />
						<circle cx="61" cy="66" r="13" fill="#FFD166" opacity=".9" />
						<circle cx="39" cy="66" r="13" fill="#FF8C42" opacity=".9" />
						<circle cx="32" cy="44" r="13" fill="#FF6F61" opacity=".9" />
						<circle cx="50" cy="50" r="10" fill="#C08552" />
					</g>
					<rect x="47" y="60" width="6" height="30" rx="3" fill="#7FB069" />
				</svg>
				<h1 class="td-loader-title">教师节快乐</h1>
				<div class="td-progress"><div id="td-progress-bar"></div></div>
				<p id="td-progress-text">正在准备惊喜… 0%</p>
				<button id="td-retry" class="td-btn" type="button" hidden>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z" fill="currentColor"/></svg>
					加载失败，点击重试
				</button>
				<button id="td-start" class="td-btn td-btn-primary" type="button" hidden>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
					开始播放
				</button>
				<p class="td-loader-tip" id="td-loader-tip">建议佩戴耳机，以获得最佳体验</p>
			</div>
		</div>

		<!-- ===== 主舞台 ===== -->
		<div id="td-stage" aria-hidden="true">
			<canvas id="td-petals"></canvas>

			<!-- 1 封面 -->
			<section class="td-page" id="td-p-cover">
				<div class="td-cover-box">
					<svg class="td-cover-deco" viewBox="0 0 200 60" aria-hidden="true">
						<path d="M10 45 Q60 10 100 40 T190 30" stroke="#FFD166" stroke-width="5" fill="none" stroke-linecap="round" class="td-chalk-line"/>
						<path d="M20 52 Q70 25 110 48 T185 42" stroke="#FF8C42" stroke-width="4" fill="none" stroke-linecap="round" class="td-chalk-line td-chalk-line2"/>
					</svg>
					<h1 class="td-cover-title" id="td-cover-title">教师节快乐</h1>
					<p class="td-cover-sub" id="td-cover-sub">高三23班同学 · 敬上</p>
					<svg class="td-cover-board" viewBox="0 0 320 200" aria-hidden="true">
						<rect x="20" y="20" width="280" height="140" rx="10" fill="#5C8D74"/>
						<rect x="20" y="20" width="280" height="140" rx="10" fill="none" stroke="#C08552" stroke-width="10"/>
						<rect x="60" y="160" width="200" height="12" rx="6" fill="#C08552"/>
						<text x="70" y="85" font-size="34" fill="#FFF8F0" font-family="'Ma Shan Zheng',cursive">9.10</text>
						<text x="70" y="125" font-size="20" fill="#FFE8CC" font-family="'Ma Shan Zheng',cursive">Thank you, teacher</text>
						<rect x="230" y="150" width="34" height="8" rx="4" fill="#FFF"/>
						<rect x="200" y="151" width="24" height="7" rx="3.5" fill="#FFD166"/>
					</svg>
				</div>
			</section>

			<!-- 2 开场 -->
			<section class="td-page" id="td-p-open">
				<div class="td-lines">
					<p class="td-line">九月的风，吹来了属于您的节日</p>
					<p class="td-line">三尺讲台，是您耕耘的天地</p>
					<p class="td-line">一支粉笔，写下我们的未来</p>
					<p class="td-line">今天，请允许我们郑重地说一句——</p>
					<p class="td-line td-line-strong">老师，节日快乐！</p>
				</div>
			</section>

			<!-- 3 回忆 -->
			<section class="td-page" id="td-p-memory">
				<div class="td-memcard" id="td-memcard">
					<p class="td-mline">还记得吗 ——</p>
					<p class="td-mline">早读课上此起彼伏的读书声</p>
					<p class="td-mline">晚自习窗外渐渐暗下来的天色</p>
					<p class="td-mline">黑板上的公式擦了又写、写了又擦</p>
					<p class="td-mline td-line-strong">而您的身影，始终在讲台前</p>
				</div>
			</section>

			<!-- 4 成长 -->
			<section class="td-page" id="td-p-growth">
				<p class="td-growth-cap" id="td-growth-cap">您陪我们走过的每一步</p>
				<div class="td-timeline" id="td-timeline">
					<div class="td-track"><div class="td-track-fill" id="td-track-fill"></div></div>
					<div class="td-nodes">
						<div class="td-node"><i></i><span>懵懂</span></div>
						<div class="td-node"><i></i><span>探索</span></div>
						<div class="td-node"><i></i><span>坚持</span></div>
						<div class="td-node"><i></i><span>蜕变</span></div>
						<div class="td-node"><i></i><span>远航</span></div>
					</div>
				</div>
			</section>

			<!-- 5 感恩 -->
			<section class="td-page" id="td-p-thanks">
				<svg class="td-thanks-svg" viewBox="0 0 640 220" aria-hidden="true">
					<text id="td-thanks-text" x="320" y="150" text-anchor="middle"
						font-size="150" font-family="'Ma Shan Zheng','ZCOOL KuaiLe',cursive"
						fill="transparent" stroke="#FF6F61" stroke-width="2.5">感恩有您</text>
				</svg>
				<p class="td-thanks-sub" id="td-thanks-sub">桃李不言，下自成蹊</p>
			</section>

			<!-- 6 教师卡片 -->
			<section class="td-page" id="td-p-cards">
				<p class="td-cards-cap" id="td-cards-cap">这一站，遇见他们</p>
				<div class="td-cards-row" id="td-cards-row"></div>
			</section>

			<!-- 教师详情（全屏放大） -->
			<div id="td-detail">
				<div class="td-detail-grid">
					<div class="td-detail-photo" id="td-detail-photo"></div>
					<div class="td-detail-main">
						<h2 class="td-detail-name" id="td-detail-name"></h2>
						<p class="td-detail-quote" id="td-detail-quote"></p>
					</div>
					<ul class="td-detail-facts" id="td-detail-facts"></ul>
				</div>
			</div>

			<!-- 7 结尾 -->
			<section class="td-page" id="td-p-ending">
				<canvas id="td-fireworks"></canvas>
				<div class="td-ending-box">
					<h1 class="td-ending-title" id="td-ending-title">您辛苦了</h1>
					<p class="td-ending-thanks" id="td-ending-thanks">Thanks for watching</p>
					<p class="td-ending-credit" id="td-ending-credit">制作：本新同学 · 高三23班 · 2026</p>
				</div>
				<button id="td-replay" class="td-btn td-replay" type="button">
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z" fill="currentColor"/></svg>
					点击重播
				</button>
			</section>

			<!-- 页码指示器 -->
			<div id="td-dots" role="presentation"></div>

			<!-- 静音 -->
			<button id="td-mute" type="button" aria-label="静音切换">
				<svg id="td-icon-sound" viewBox="0 0 24 24" width="22" height="22"><path d="M3 10v4h4l5 5V5L7 10H3z" fill="currentColor"/><path d="M16 8a5 5 0 0 1 0 8M18.5 5.5a9 9 0 0 1 0 13" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
				<svg id="td-icon-mute" viewBox="0 0 24 24" width="22" height="22" style="display:none"><path d="M3 10v4h4l5 5V5L7 10H3z" fill="currentColor"/><path d="M16 9l6 6M22 9l-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
			</button>
		</div>
	</div>

	<style is:global>
		/* ===== 教师节页面全局样式 ===== */
		#td-root {
			--td-cream: #fff8f0;
			--td-apricot: #fff3e0;
			--td-orange: #ff8c42;
			--td-coral: #ff6f61;
			--td-yellow: #ffd166;
			--td-brown: #c08552;
			--td-ink: #5b3a29;
		}
		#td-root, #td-root * { box-sizing: border-box; }

		/* ---- 加载页 ---- */
		#td-loader {
			position: fixed; inset: 0; z-index: 200;
			display: flex; align-items: center; justify-content: center;
			background: linear-gradient(135deg, #fff8f0 0%, #fff3e0 45%, #ffe3c2 100%);
			transition: opacity .6s ease, visibility .6s;
		}
		#td-loader.td-gone { opacity: 0; visibility: hidden; pointer-events: none; }
		.td-loader-inner { text-align: center; padding: 24px; max-width: 420px; width: 100%; }
		.td-flower-spin { transform-origin: 50px 50px; animation: td-spin 6s linear infinite; }
		@keyframes td-spin { to { transform: rotate(360deg); } }
		.td-loader-title {
			font-family: "Ma Shan Zheng", "ZCOOL KuaiLe", "Yuanti SC", "YouYuan", cursive;
			font-size: clamp(2rem, 8vw, 3rem); color: var(--td-ink); margin: 18px 0 22px;
		}
		.td-progress {
			height: 10px; border-radius: 999px; overflow: hidden;
			background: rgba(192,133,82,.18); box-shadow: inset 0 1px 3px rgba(91,58,41,.12);
		}
		#td-progress-bar {
			height: 100%; width: 0%; border-radius: 999px;
			background: linear-gradient(90deg, var(--td-yellow), var(--td-orange), var(--td-coral));
			transition: width .25s ease;
		}
		#td-progress-text { margin-top: 10px; color: #a4764f; font-size: .9rem; }
		.td-loader-tip { margin-top: 18px; color: #c4a07e; font-size: .8rem; }
		.td-btn {
			display: inline-flex; align-items: center; gap: 8px;
			margin-top: 20px; padding: 12px 28px; border: none; cursor: pointer;
			border-radius: 999px; font-size: 1rem; font-weight: 700; color: var(--td-ink);
			background: #fff; box-shadow: 0 6px 18px rgba(192,133,82,.25);
			transition: transform .18s ease, box-shadow .18s ease, background .18s;
		}
		.td-btn:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 10px 26px rgba(192,133,82,.35); }
		.td-btn:active { transform: scale(.96); }
		.td-btn-primary {
			color: #fff; background: linear-gradient(120deg, var(--td-orange), var(--td-coral));
			animation: td-breathe 1.6s ease-in-out infinite;
		}
		@keyframes td-breathe { 0%,100% { box-shadow: 0 6px 18px rgba(255,111,97,.35);} 50% { box-shadow: 0 6px 30px rgba(255,140,66,.65);} }

		/* ---- 舞台 ---- */
		#td-stage {
			position: fixed; inset: 0; z-index: 60; overflow: hidden;
			background:
				radial-gradient(1200px 600px at 80% -10%, rgba(255,209,102,.25), transparent 60%),
				radial-gradient(900px 500px at 10% 110%, rgba(255,111,97,.16), transparent 60%),
				linear-gradient(160deg, var(--td-cream), var(--td-apricot));
			opacity: 0; visibility: hidden; transition: opacity .8s ease, visibility .8s;
			touch-action: none;
			font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
		}
		#td-stage.td-on { opacity: 1; visibility: visible; }
		#td-petals, #td-fireworks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

		.td-page {
			position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
			opacity: 0; visibility: hidden; transition: opacity .45s ease, visibility .45s;
			padding: clamp(16px, 4vw, 48px);
		}
		.td-page.td-active { opacity: 1; visibility: visible; }

		/* ---- 封面 ---- */
		.td-cover-box { text-align: center; position: relative; }
		.td-cover-deco { width: clamp(160px, 40vw, 280px); margin-bottom: -8px; }
		.td-chalk-line { stroke-dasharray: 400; stroke-dashoffset: 400; }
		.td-active .td-chalk-line { animation: td-draw 1.4s .9s ease forwards; }
		.td-active .td-chalk-line2 { animation-delay: 1.15s; }
		@keyframes td-draw { to { stroke-dashoffset: 0; } }
		.td-cover-title {
			font-family: "Ma Shan Zheng", "ZCOOL KuaiLe", "Yuanti SC", "YouYuan", cursive;
			font-size: clamp(3rem, 13vw, 6.5rem); color: var(--td-ink); line-height: 1.15;
			text-shadow: 0 4px 0 rgba(255,140,66,.18);
		}
		.td-cover-title .td-ch {
			display: inline-block; opacity: 0; transform: translateY(60px) scale(.3) rotate(-12deg);
		}
		.td-active .td-cover-title .td-ch {
			animation: td-chpop .7s cubic-bezier(.34,1.8,.5,1) forwards;
			animation-delay: calc(.35s + var(--i) * .16s);
		}
		@keyframes td-chpop {
			60% { opacity: 1; transform: translateY(-8px) scale(1.12) rotate(3deg); }
			100% { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
		}
		.td-cover-sub {
			margin-top: 14px; font-size: clamp(1rem, 3.6vw, 1.4rem); letter-spacing: .35em;
			color: var(--td-brown); opacity: 0; transform: translateY(16px);
		}
		.td-active .td-cover-sub { animation: td-fadeup .8s 1.5s ease forwards; }
		@keyframes td-fadeup { to { opacity: 1; transform: translateY(0); } }
		.td-cover-board {
			width: clamp(220px, 56vw, 340px); margin-top: 22px;
			opacity: 0; transform: translateY(30px) rotate(-2deg);
			filter: drop-shadow(0 12px 24px rgba(192,133,82,.3));
		}
		.td-active .td-cover-board { animation: td-fadeup .9s 1.9s cubic-bezier(.34,1.56,.64,1) forwards; }

		/* ---- 开场 / 回忆 ---- */
		.td-lines { text-align: center; max-width: 760px; }
		.td-line {
			font-size: clamp(1.15rem, 4.4vw, 1.9rem); color: var(--td-ink);
			margin: .65em 0; opacity: 0; transform: translateY(26px); filter: blur(6px);
		}
		.td-line-strong {
			font-family: "Ma Shan Zheng", cursive; font-size: clamp(1.6rem, 6.4vw, 2.6rem);
			color: var(--td-coral);
		}
		.td-active .td-line {
			animation: td-linein .8s cubic-bezier(.22,1.2,.36,1) forwards;
			animation-delay: calc(.3s + var(--i) * .75s);
		}
		@keyframes td-linein { to { opacity: 1; transform: translateY(0); filter: blur(0); } }

		.td-memcard {
			background: rgba(255,255,255,.75); backdrop-filter: blur(6px);
			border: 2px solid rgba(255,140,66,.25); border-radius: 24px;
			padding: clamp(22px, 5vw, 44px) clamp(26px, 6vw, 60px);
			box-shadow: 0 20px 50px rgba(192,133,82,.28);
			max-width: 720px; text-align: center;
			opacity: 0; transform: perspective(900px) rotateX(18deg) translateY(40px);
		}
		.td-active .td-memcard {
			animation: td-cardin .9s cubic-bezier(.34,1.56,.64,1) forwards, td-sway 5s 1s ease-in-out infinite alternate;
		}
		@keyframes td-cardin { to { opacity: 1; transform: perspective(900px) rotateX(0) translateY(0); } }
		@keyframes td-sway {
			from { transform: perspective(900px) rotateY(-3.5deg); }
			to { transform: perspective(900px) rotateY(3.5deg); }
		}
		.td-mline {
			font-size: clamp(1.05rem, 4vw, 1.7rem); color: var(--td-ink); margin: .6em 0;
			opacity: 0; transform: translateX(-40px);
		}
		.td-mline:nth-child(even) { transform: translateX(40px); }
		.td-active .td-mline {
			animation: td-slidein .7s cubic-bezier(.22,1.2,.36,1) forwards;
			animation-delay: calc(.7s + var(--i) * .62s);
		}
		@keyframes td-slidein { to { opacity: 1; transform: translateX(0); } }

		/* ---- 成长时间轴 ---- */
		.td-growth-cap {
			position: absolute; top: 16%; left: 0; right: 0; text-align: center;
			font-family: "Ma Shan Zheng", cursive; font-size: clamp(1.5rem, 5.6vw, 2.4rem);
			color: var(--td-ink); opacity: 0; transform: translateY(20px);
		}
		.td-active .td-growth-cap { animation: td-fadeup .7s .2s ease forwards; }
		.td-timeline { width: min(860px, 92vw); }
		.td-track { height: 6px; border-radius: 999px; background: rgba(192,133,82,.2); overflow: hidden; }
		.td-track-fill {
			height: 100%; width: 0%; border-radius: 999px;
			background: linear-gradient(90deg, var(--td-yellow), var(--td-orange), var(--td-coral));
		}
		.td-active .td-track-fill { animation: td-track 3.4s .5s ease-in-out forwards; }
		@keyframes td-track { to { width: 100%; } }
		.td-nodes { display: flex; justify-content: space-between; margin-top: -14px; }
		.td-node { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 20%; }
		.td-node i {
			width: 22px; height: 22px; border-radius: 50%;
			background: #fff; border: 4px solid rgba(192,133,82,.35);
			transform: scale(.4); opacity: .5;
		}
		.td-node span {
			font-size: clamp(.85rem, 3vw, 1.15rem); color: #a4764f; font-weight: 700;
			opacity: 0; transform: translateY(12px);
		}
		.td-active .td-node i {
			animation: td-nodepop .55s cubic-bezier(.34,2,.5,1) forwards;
			animation-delay: calc(.55s + var(--i) * .62s);
		}
		.td-active .td-node span {
			animation: td-fadeup .5s ease forwards;
			animation-delay: calc(.7s + var(--i) * .62s);
		}
		@keyframes td-nodepop {
			to { transform: scale(1); opacity: 1; border-color: var(--td-orange); background: var(--td-yellow); box-shadow: 0 0 0 8px rgba(255,209,102,.3), 0 0 22px rgba(255,140,66,.55); }
		}

		/* ---- 感恩 ---- */
		.td-thanks-svg { width: min(640px, 88vw); overflow: visible; }
		#td-thanks-text { stroke-dasharray: 1200; stroke-dashoffset: 1200; }
		.td-active #td-thanks-text {
			animation: td-write 2.6s .3s ease forwards, td-fillin .9s 2.7s ease forwards;
		}
		@keyframes td-write { to { stroke-dashoffset: 0; } }
		@keyframes td-fillin { to { fill: var(--td-coral); } }
		.td-thanks-sub {
			position: absolute; top: 62%; left: 0; right: 0; text-align: center;
			font-size: clamp(1rem, 3.8vw, 1.5rem); letter-spacing: .5em; color: var(--td-brown);
			opacity: 0; transform: translateY(18px);
		}
		.td-active .td-thanks-sub { animation: td-fadeup .8s 3s ease forwards; }

		/* ---- 教师卡片 ---- */
		.td-cards-cap {
			position: absolute; top: 9%; left: 0; right: 0; text-align: center;
			font-family: "Ma Shan Zheng", cursive; font-size: clamp(1.4rem, 5vw, 2.2rem); color: var(--td-ink);
			opacity: 0; transform: translateY(16px); transition: opacity .5s, transform .5s;
		}
		.td-cards-cap.td-show { opacity: 1; transform: none; }
		.td-cards-row {
			display: flex; gap: clamp(8px, 1.6vw, 20px); justify-content: center; align-items: stretch;
			width: min(1200px, 96vw); perspective: 1200px;
		}
		.td-card {
			flex: 1 1 0; min-width: 0; aspect-ratio: 3 / 4.4; max-height: 46vh;
			border-radius: clamp(10px, 1.6vw, 18px); overflow: hidden; position: relative;
			background: linear-gradient(160deg, #fff, #ffe9d2);
			border: 2px solid rgba(255,140,66,.35);
			box-shadow: 0 14px 34px rgba(192,133,82,.3);
			display: flex; align-items: center; justify-content: center; text-align: center;
			opacity: 0; will-change: transform;
		}
		.td-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
		.td-card-label {
			position: relative; z-index: 1; padding: 10px; font-weight: 700; color: var(--td-ink);
			font-size: clamp(.62rem, 1.7vw, 1rem); line-height: 1.5;
		}
		.td-card .td-card-band {
			position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
			background: linear-gradient(transparent, rgba(91,58,41,.72));
			color: #fff8f0; font-size: clamp(.6rem, 1.6vw, .95rem); font-weight: 700;
			padding: 18px 6px 8px;
		}
		.td-card.td-dim { opacity: .25 !important; transition: opacity .4s; }

		/* ---- 教师详情 ---- */
		#td-detail {
